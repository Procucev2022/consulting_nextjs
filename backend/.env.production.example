NODE_ENV=production
PORT=5001
FRONTEND_URL=https://replace-with-frontend-origin
APP_URL=https://replace-with-frontend-origin
APP_ENCRYPTION_KEY=set-in-cloudflare-secret-store
AUTH_SECRET=set-in-cloudflare-secret-store
R2_BUCKET=consulting-doc
D1_DATABASE_NAME=consulting-db
ADMIN_EMAIL=set-in-secret-store
ADMIN_MOBILE=set-in-secret-store
GEMINI_API_KEY=set-in-cloudflare-secret-store
GEMINI_BACKUP_KEYS=set-in-cloudflare-secret-store
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_PRIMARY_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-3.5-flash-lite
GEMINI_REQUEST_TIMEOUT_MS=20000
GEMINI_TOTAL_BUDGET_MS=45000
GEMINI_MIN_ATTEMPT_MS=3000
GEMINI_MAX_DOCUMENT_BYTES=10485760
GEMINI_MAX_DOCUMENT_TEXT_CHARS=120000
LOG_LEVEL=info
LOG_RETENTION_DAYS=14
