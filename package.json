{
  "name": "consulting-nextjs",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"frontend,backend\" -c \"cyan,green\" \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "next dev -p 3001",
    "dev:backend": "npm --prefix backend run dev",
    "build": "npm --prefix backend run build && next build",
    "build:frontend": "next build",
    "build:backend": "npm --prefix backend run build",
    "start": "concurrently -n \"frontend,backend\" -c \"cyan,green\" \"npm run start:frontend\" \"npm run start:backend\"",
    "start:frontend": "next start -p 3001",
    "start:backend": "npm --prefix backend run start",
    "lint": "next lint",
    "postinstall": "npm --prefix backend install"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.1.2",
    "postcss": "^8.4.38",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.4.5"
  }
}
