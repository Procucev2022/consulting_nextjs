{
  "name": "aicev-desktop",
  "version": "1.0.2",
  "private": true,
  "description": "aiCEV Internal Assessment Desktop Application (Electron Shell)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "tsc -p tsconfig.json && electron .",
    "pack": "tsc -p tsconfig.json && electron-builder --dir",
    "dist": "tsc -p tsconfig.json && electron-builder --win nsis"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.4.5"
  },
  "build": {
    "appId": "com.procucev.aicev.internal",
    "productName": "aiCEV - Internal Assessment",
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "release-manifest.json",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/aicev-icon.ico",
      "artifactName": "aiCEV-Internal-Assessment-Setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "aiCEV – Internal Assessment",
      "installerIcon": "assets/aicev-icon.ico",
      "uninstallerIcon": "assets/aicev-icon.ico",
      "uninstallDisplayName": "aiCEV – Internal Assessment",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false
    }
  }
}
