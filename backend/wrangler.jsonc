{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "consulting-nextjs-backend",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "consulting-db",
      "database_id": "9286122b-f5e3-413a-9061-a36a84a8787a"
    }
  ],
  "r2_buckets": [
    {
      "binding": "OBJECTS",
      "bucket_name": "consulting-doc"
    }
  ],
  "ratelimits": [
    {
      "name": "CLIENT_ERROR_RATE_LIMITER",
      "namespace_id": "8110801",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "vars": {
    "D1_DATABASE_NAME": "consulting-db",
    "R2_BUCKET": "consulting-doc",
    "LOG_PERSISTENCE": "false",
    "APP_OPERATING_MODE": "INTERNAL_ASSESSMENT",
    "FRONTEND_URL": "https://consulting-frontend.srinivas-mukku.workers.dev",
    "NEXT_PUBLIC_APP_URL": "https://consulting-frontend.srinivas-mukku.workers.dev",
    "GEMINI_BASE_URL": "https://generativelanguage.googleapis.com/v1beta/models",
    "GEMINI_PRIMARY_MODEL": "gemini-3.5-flash",
    "GEMINI_FALLBACK_MODELS": "gemini-flash-latest,gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.7-flash",
    "GEMINI_REQUEST_TIMEOUT_MS": 20000,
    "GEMINI_TOTAL_BUDGET_MS": 45000,
    "GEMINI_MIN_ATTEMPT_MS": 3000,
    "GEMINI_MAX_DOCUMENT_BYTES": 10485760,
    "GEMINI_MAX_DOCUMENT_TEXT_CHARS": 120000
  },
  "env": {
    "dev": {
      "name": "consulting-nextjs-backend-dev",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "consulting_dev",
          "database_id": "cd822525-56bf-4c48-ac0a-666bea7dd631"
        }
      ],
      "r2_buckets": [
        {
          "binding": "OBJECTS",
          "bucket_name": "consulting-doc-dev"
        }
      ],
      "ratelimits": [
        {
          "name": "CLIENT_ERROR_RATE_LIMITER",
          "namespace_id": "8110802",
          "simple": { "limit": 60, "period": 60 }
        }
      ],
      "vars": {
        "D1_DATABASE_NAME": "consulting_dev",
        "R2_BUCKET": "consulting-doc-dev",
        "LOG_PERSISTENCE": "false",
        "APP_OPERATING_MODE": "INTERNAL_ASSESSMENT",
        "FRONTEND_URL": "https://consulting-frontend-dev.anshul-goel.workers.dev",
        "NEXT_PUBLIC_APP_URL": "https://consulting-frontend-dev.anshul-goel.workers.dev",
        "GEMINI_BASE_URL": "https://generativelanguage.googleapis.com/v1beta/models",
        "GEMINI_PRIMARY_MODEL": "gemini-3.5-flash",
        "GEMINI_FALLBACK_MODELS": "gemini-flash-latest,gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.7-flash",
        "GEMINI_REQUEST_TIMEOUT_MS": 20000,
        "GEMINI_TOTAL_BUDGET_MS": 45000,
        "GEMINI_MIN_ATTEMPT_MS": 3000,
        "GEMINI_MAX_DOCUMENT_BYTES": 10485760,
        "GEMINI_MAX_DOCUMENT_TEXT_CHARS": 120000
      }
    },
    "prod": {
      "name": "consulting-nextjs-backend",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "consulting-db",
          "database_id": "9286122b-f5e3-413a-9061-a36a84a8787a"
        }
      ],
      "r2_buckets": [
        {
          "binding": "OBJECTS",
          "bucket_name": "consulting-doc"
        }
      ],
      "ratelimits": [
        {
          "name": "CLIENT_ERROR_RATE_LIMITER",
          "namespace_id": "8110801",
          "simple": { "limit": 60, "period": 60 }
        }
