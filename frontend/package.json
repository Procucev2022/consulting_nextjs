{
  "name": "consulting-frontend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "next:build": "next build",
    "cloudflare:build": "opennextjs-cloudflare build",
    "build:vinext": "npm run cloudflare:build",
    "cloudflare:preview": "npm run cloudflare:build && opennextjs-cloudflare preview",
    "cloudflare:deploy": "npm run cloudflare:build && wrangler deploy",
    "deploy": "npm run cloudflare:build && wrangler deploy",
    "start": "next start -p 3001",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:fast": "vitest run --changed --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage --reporter=default --reporter=json --outputFile=test-results.json",
    "check:budget": "node scripts/check-budget.js"
  },
  "dependencies": {
    "@exodus/bytes": "^1.16.0",
    "canvas-confetti": "^1.9.4",
    "chart.js": "^4.6.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.67.0",
    "next": "16.4.5",
    "nodemailer": "^10.3.1",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.16",
    "@tailwindcss/postcss": "^4.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.29",
    "jsdom": "26.0.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.4.5",
    "vite": "6.4.5",
    "vitest": "4.1.12",
    "wrangler": "^4.157.0"
  },
  "overrides": {
    "postcss": "^8.5.32",
    "glob": "14.0.3",
    "minimatch": "11.0.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "unrs-resolver@1.12.2": true,
    "workerd@1.20261103.1": true
  }
}
