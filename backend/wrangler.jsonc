{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "consulting-nextjs-backend",
	"main": "src/worker.ts",
	"compatibility_date": "2026-09-15",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"workers_dev": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "consulting-db",
			"database_id": "4e7c2ba7-5cd2-4028-a630-2b5ae88625db"
		}
	],
	"r2_buckets": [
		{
			"binding": "OBJECTS",
			"bucket_name": "consulting-doc"
		}
	]
}