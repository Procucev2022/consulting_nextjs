{
  "name": "consulting-backend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "description": "Cloudflare Worker backend (D1 and R2) for the Consulting Platform",
  "scripts": {
    "build": "tsc",
    "cloudflare:dev": "wrangler dev --env dev --persist-to .wrangler/state",
    "cloudflare:deploy": "wrangler deploy",
    "cloudflare:types": "wrangler types",
    "db:push": "node scripts/db-push.js",
    "db:drift": "node scripts/d1-drift-check.js",
    "db:drift:remote": "node scripts/d1-drift-check.js --remote",
    "db:seed:d1": "node scripts/db-push.js --seed-all",
    "db:seed:d1:base": "node scripts/db-push.js --seed",
    "db:seed:d1:remote": "node scripts/db-push.js --seed-all --remote",
    "db:seed:d1:remote:base": "node scripts/db-push.js --seed --remote",
    "test": "vitest run",
    "test:fast": "vitest run --changed --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage --reporter=default --reporter=json --outputFile=test-results.json",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "graphql": "^17.0.2",
    "pptxgenjs": "^4.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@vitest/coverage-v8": "4.1.12",
    "balanced-match": "^1.0.2",
    "brace-expansion": "^2.0.1",
    "eslint": "8.57.1",
    "typescript": "^5.4.5",
    "vite": "6.4.5",
    "vitest": "4.1.12",
    "wrangler": "^4.157.0"
  },
  "overrides": {
    "image-size": "2.0.4",
    "qs": "^6.16.0",
    "minimatch": "11.0.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "workerd@1.20261103.1": true
  }
}
