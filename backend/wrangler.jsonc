{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "consulting-nextjs-backend",
	"main": "src/worker.ts",
	"compatibility_date": "2026-09-15",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": true,
	"vars": {
		"AUTH_SECRET": "a1b2c3d4e5f60718293a4b5c6d7e8f90_procucev_secret_key_2026",
		"FRONTEND_URL": "https://consulting-frontend.navinchaudhary-dev.workers.dev"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "consulting-db",
			"database_id": "fdfc9836-9cd7-4f94-a825-372be398fdc5"
		}
	]
}