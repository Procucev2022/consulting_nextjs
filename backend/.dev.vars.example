# Cloudflare Worker development bindings. Copy to backend/.dev.vars and replace secrets locally.
NODE_ENV=development
FRONTEND_URL=http://localhost:3001
APP_URL=http://localhost:3001
APP_ENCRYPTION_KEY=replace_with_exactly_32_bytes_for_dev
AUTH_SECRET=replace_with_a_local_only_secret
R2_BUCKET=consulting-doc
D1_DATABASE_NAME=consulting_dev
ADMIN_EMAIL=admin@example.invalid
ADMIN_MOBILE=+10000000000
GEMINI_API_KEY=
GEMINI_BACKUP_KEYS=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_PRIMARY_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-3.5-flash-lite
GEMINI_REQUEST_TIMEOUT_MS=20000
GEMINI_TOTAL_BUDGET_MS=45000
GEMINI_MIN_ATTEMPT_MS=3000
GEMINI_MAX_DOCUMENT_BYTES=10485760
GEMINI_MAX_DOCUMENT_TEXT_CHARS=120000
