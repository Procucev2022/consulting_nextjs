{
  "name": "consulting-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone Node.js Express backend with PostgreSQL & Prisma for Consulting Platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node scripts/generate-client.js && tsc",
    "start": "node dist/server.js",
    "cloudflare:dev": "wrangler dev",
    "cloudflare:deploy": "wrangler deploy",
    "cloudflare:types": "wrangler types",
    "db:generate": "prisma generate",
    "db:push": "prisma db push --skip-generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:view": "prisma studio",
    "db:setup": "prisma generate && prisma db push && tsx prisma/seed.ts",
    "test": "vitest run",
    "test:fast": "vitest run --changed --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage --reporter=default --reporter=json --outputFile=test-results.json",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1133.0",
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "graphql": "^17.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitest/coverage-v8": "^3.0.7",
    "eslint": "^8.57.1",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "tsx": "4.19.2",
    "typescript": "^5.4.5",
    "vite": "^6.2.0",
    "vitest": "^3.0.7",
    "wrangler": "^4.133.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
