{
  "name": "consulting-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker backend (D1 and R2) for the Consulting Platform",
  "scripts": {
    "build": "tsc",
    "cloudflare:dev": "wrangler dev",
    "cloudflare:deploy": "wrangler deploy",
    "cloudflare:types": "wrangler types",
    "db:push": "node scripts/db-push.js",
    "db:seed:d1": "node scripts/db-push.js --seed",
    "db:seed:d1:remote": "node scripts/db-push.js --seed --remote",
    "test": "vitest run",
    "test:fast": "vitest run --changed --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage --reporter=default --reporter=json --outputFile=test-results.json",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "graphql": "^17.0.2",
    "pptxgenjs": "^4.0.1",
    "xlsx": "^0.18.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^3.0.7",
    "balanced-match": "^1.0.2",
    "brace-expansion": "^2.0.1",
    "eslint": "^8.57.1",
    "typescript": "^5.4.5",
    "vite": "^6.2.0",
    "vitest": "^3.0.7",
    "wrangler": "4.131.2"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
